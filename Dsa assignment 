Q2) A service centre uses a fixed-size request buffer in which released positions must be reused.
Write a C program to implement a Circular Queue using an array with insertion, deletion, display,
overflow and underflow operations. Demonstrate that positions freed after deletion can be reused
for new requests.

SOL)
CODE:
#include <stdio.h>
#define SIZE 5

int queue[SIZE];
int front = -1;
int rear = -1;

int isFull() {
    if ((front == 0 && rear == SIZE - 1) || (front == rear + 1)) {
        return 1;
    }
    return 0;
}

int isEmpty() {
    if (front == -1) {
        return 1;
    }
    return 0;
}

void insert(int value) {
    if (isFull()) {
        printf("Overflow! Request buffer is full. Cannot insert %d.\n", value);
        return;
    }
    if (front == -1) {
        front = 0;
        rear = 0;
    } else if (rear == SIZE - 1 && front != 0) {
        rear = 0;
    } else {
        rear++;
    }
    queue[rear] = value;
    printf("Successfully inserted request ID: %d\n", value);
}

void delete() {
    if (isEmpty()) {
        printf("Underflow! Request buffer is empty. No request to process.\n");
        return;
    }
    printf("Processed and removed request ID: %d (Position %d freed)\n", queue[front], front);
    if (front == rear) {
        front = -1;
        rear = -1;
    } else if (front == SIZE - 1) {
        front = 0;
    } else {
        front++;
    }
}

void display() {
    if (isEmpty()) {
        printf("Request buffer is currently empty.\n");
        return;
    }
    printf("Current Request Buffer: ");
    int i = front;
    if (front <= rear) {
        while (i <= rear) {
            printf("%d ", queue[i]);
            i++;
        }
    } else {
        while (i < SIZE) {
            printf("%d ", queue[i]);
            i++;
        }
        i = 0;
        while (i <= rear) {
            printf("%d ", queue[i]);
            i++;
        }
    }
    printf("\nIndices -> Front: %d, Rear: %d\n", front, rear);
}

int main() {
    printf("--- Initializing Circular Queue of Size %d ---\n\n", SIZE);

    printf("Step 1: Fill the queue completely\n");
    insert(101);
    insert(102);
    insert(103);
    insert(104);
    insert(105);
    display();

    printf("\nStep 2: Attempt overflow insertion when full\n");
    insert(106);

    printf("\nStep 3: Delete two items to free positions at the beginning\n");
    delete();
    delete();
    display();

    printf("\nStep 4: Reuse freed positions by inserting new requests\n");
    insert(106);
    insert(107);
    display();

    printf("\nStep 5: Attempt overflow again with wrapped-around queue\n");
    insert(108);

    printf("\nStep 6: Empty the queue completely to test underflow\n");
    delete();
    delete();
    delete();
    delete();
    delete();
    delete(); // Triggers underflow

    return 0;
}

