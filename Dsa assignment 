Q2) Develop a C program for a Doubly Linked List representing a sequence of web pages visited by a
user. The program should insert a new page, move forward and backward, delete a specified
page, and display the pages from first-to-last and last-to-first while handling beginning and end
conditions correctly.
SOL)
CODE:
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

struct Node {
    char url[100];
    struct Node* prev;
    struct Node* next;
};

struct Node* head = NULL;
struct Node* current = NULL;

void displayForward() {
    struct Node* temp = head;
    if (temp == NULL) {
        printf("History is empty.\n");
        return;
    }
    printf("History (First to Last): ");
    while (temp != NULL) {
        if (temp == current) {
            printf("[Current: %s] <-> ", temp->url);
        } else {
            printf("%s <-> ", temp->url);
        }
        temp = temp->next;
    }
    printf("NULL\n");
}

void displayBackward() {
    struct Node* temp = head;
    if (temp == NULL) {
        printf("History is empty.\n");
        return;
    }
    while (temp->next != NULL) {
        temp = temp->next;
    }
    printf("History (Last to First): ");
    while (temp != NULL) {
        if (temp == current) {
            printf("[Current: %s] <-> ", temp->url);
        } else {
            printf("%s <-> ", temp->url);
        }
        temp = temp->prev;
    }
    printf("NULL\n");
}

void visitPage(char* url) {
    struct Node* newNode = (struct Node*)malloc(sizeof(struct Node));
    strcpy(newNode->url, url);
    newNode->next = NULL;
    newNode->prev = NULL;

    if (head == NULL) {
        head = newNode;
        current = newNode;
    } else {
        struct Node* temp = current->next;
        while (temp != NULL) {
            struct Node* nextNode = temp->next;
            free(temp);
            temp = nextNode;
        }
        current->next = newNode;
        newNode->prev = current;
        current = newNode;
    }
    printf("Visited: %s\n", url);
    displayForward();
}

void moveBack() {
    if (current != NULL && current->prev != NULL) {
        current = current->prev;
        printf("Moved backward to: %s\n", current->url);
    } else {
        printf("You are already at the first page. Cannot go back further.\n");
    }
    displayForward();
}

void moveForward() {
    if (current != NULL && current->next != NULL) {
        current = current->next;
        printf("Moved forward to: %s\n", current->url);
    } else {
        printf("You are already at the last page. Cannot go forward further.\n");
    }
    displayForward();
}

void deletePage(char* url) {
    struct Node* temp = head;
    while (temp != NULL && strcmp(temp->url, url) != 0) {
        temp = temp->next;
    }

    if (temp == NULL) {
        printf("Page '%s' not found in history.\n", url);
        return;
    }

    if (temp == head) {
        head = temp->next;
        if (head != NULL) {
            head->prev = NULL;
        }
    } else {
        temp->prev->next = temp->next;
        if (temp->next != NULL) {
            temp->next->prev = temp->prev;
        }
    }

    if (current == temp) {
        if (temp->next != NULL) {
            current = temp->next;
        } else if (temp->prev != NULL) {
            current = temp->prev;
        } else {
            current = NULL;
        }
    }

    free(temp);
    printf("Deleted page '%s' from history.\n", url);
    displayForward();
}

int main() {
    int choice;
    char url[100];

    while (1) {
        printf("\n--- Browser History Management Menu ---\n");
        printf("1. Visit New Page\n");
        printf("2. Move Backward\n");
        printf("3. Move Forward\n");
        printf("4. Delete Specific Page\n");
        printf("5. Display Forward (First to Last)\n");
        printf("6. Display Backward (Last to First)\n");
        printf("7. Exit\n");
        printf("Enter your choice: ");

        if (scanf("%d", &choice) != 1) {
            printf("Invalid input. Exiting.\n");
            break;
        }

        switch (choice) {
            case 1:
                printf("Enter URL to visit: ");
                scanf("%s", url);
                visitPage(url);
                break;
            case 2:
                moveBack();
                break;
            case 3:
                moveForward();
                break;
            case 4:
                printf("Enter URL to delete: ");
                scanf("%s", url);
                deletePage(url);
                break;
            case 5:
                displayForward();
                break;
            case 6:
                displayBackward();
                break;
            case 7:
                printf("Exiting program.\n");
                exit(0);
            default:
                printf("Invalid choice! Please choose between 1 and 7.\n");
        }
    }

    return 0;
}
