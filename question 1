#include <stdio.h>

int main() {
    int n, key, low, high, mid;
    int comparisons = 0;
    int found = 0;

    printf("Enter the number of employee IDs: ");
    if (scanf("%d", &n) != 1 || n <= 0) {
        printf("Invalid input for number of employees.\n");
        return 1;
    }

    int emp_ids[n];
    printf("Enter %d employee IDs in ascending order:\n", n);
    for (int i = 0; i < n; i++) {
        scanf("%d", &emp_ids[i]);
    }
    printf("Enter the employee ID to search: ");
    scanf("%d", &key);
    low = 0;
    high = n - 1;

    while (low <= high) {
        comparisons++;
        mid = low + (high - low) / 2;

        if (emp_ids[mid] == key) {
            found = 1;
            break;
        } else if (emp_ids[mid] < key) {
            low = mid + 1;
        } else {
            high = mid - 1;
        }
    }
    if (found) {
        printf("\nStatus: Success (ID found)\n");
        printf("Position: %d (0-indexed: %d)\n", mid + 1, mid);
        printf("Total comparisons: %d\n", comparisons);
    } else {
        printf("\nStatus: Failure (ID not found)\n");
        printf("Total comparisons: %d\n", comparisons);
    }

    return 0;
}
